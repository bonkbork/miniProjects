int binarySearch(int nums[], int length, int target)
{
    int first = 0, last = length - 1, mid;
    while(first < last)
    {
        mid = (first + last) / 2;
        if(target <= nums[mid])
        {
            last = mid;
        }
        else
        {
            first = mid + 1;
        }
    }
    if(nums[first] == target)
    {
        return first;
    }
    return -1;
}
